/**
 * 全局样式 - 温馨可爱暖色系主题
 * 流浪猫狗寻回领养救助平台
 */

/* ========== CSS 变量定义 ========== */
page {
  --color-primary: #FF8C6B;        /* 珊瑚橙 - 主色 */
  --color-primary-light: #FFB89A;  /* 浅珊瑚 - 辅助色 */
  --color-primary-bg: #FFF0EB;     /* 浅粉底 - 背景色 */
  --color-accent: #FFD4A8;         /* 杏色 - 点缀 */
  --color-warning: #FFB84D;        /* 暖黄 - 提醒 */
  --color-success: #6BCB77;        /* 柔绿 - 成功 */
  --color-info: #7EC8E3;           /* 淡蓝 - 信息 */
  --color-white: #FFFFFF;
  --color-bg: #FFF5F0;             /* 全局背景 */
  --color-text: #333333;           /* 主文字 */
  --color-text-secondary: #888888; /* 次要文字 */
  --color-text-light: #AAAAAA;     /* 提示文字 */
  --color-border: #F0E0D6;         /* 边框色 */
  --color-card-bg: #FFFFFF;        /* 卡片背景 */

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-round: 50%;

  --shadow-card: 0 4rpx 20rpx rgba(255, 140, 107, 0.1);
  --shadow-hover: 0 8rpx 30rpx rgba(255, 140, 107, 0.18);

  --font-xs: 22rpx;
  --font-sm: 26rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  box-sizing: border-box;
  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-md);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* ========== 通用按钮 ========== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
  color: var(--color-white);
  font-size: var(--font-lg);
  font-weight: 600;
  border-radius: var(--radius-lg);
  border: none;
  box-shadow: var(--shadow-card);
  transition: all 0.3s;
}
.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: var(--color-white);
  color: var(--color-primary);
  font-size: var(--font-lg);
  font-weight: 500;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-primary);
  transition: all 0.3s;
}
.btn-outline:active {
  background: var(--color-primary-bg);
}

.btn-sm {
  height: 60rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-sm);
  border-radius: var(--radius-sm);
}

/* ========== 通用卡片 ========== */
.card {
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

/* ========== 通用标签 ========== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: var(--font-xs);
  border-radius: 20rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.tag-primary {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}
.tag-warning {
  background: #FFF8ED;
  color: #E8952E;
}
.tag-success {
  background: #EDF8EE;
  color: #4CAF50;
}
.tag-info {
  background: #EDF4F8;
  color: #5C9FBF;
}

/* ========== 通用表单 ========== */
.form-group {
  margin-bottom: var(--spacing-md);
}
.form-label {
  display: block;
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: var(--spacing-xs);
}
.form-label .required {
  color: var(--color-primary);
  margin-left: 4rpx;
}
.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-md);
  background: var(--color-white);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.form-input:focus {
  border-color: var(--color-primary);
}
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--spacing-md);
  font-size: var(--font-md);
  background: var(--color-white);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.form-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  padding: var(--spacing-md);
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}
.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
}
.empty-state .empty-text {
  color: var(--color-text-light);
  font-size: var(--font-sm);
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: var(--spacing-sm) 0;
}

/* ========== flex 布局辅助 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.flex-wrap {
  flex-wrap: wrap;
}
.flex-1 {
  flex: 1;
}

/* ========== 间距辅助 ========== */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.ml-sm { margin-left: var(--spacing-sm); }
.mr-sm { margin-right: var(--spacing-sm); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }

/* ========== 文字辅助 ========== */
.text-center { text-align: center; }
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-light { color: var(--color-text-light); }
.text-sm { font-size: var(--font-sm); }
.text-lg { font-size: var(--font-lg); }
.text-xl { font-size: var(--font-xl); }
.text-bold { font-weight: 600; }

/* ========== 安全区域底部 ========== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
