.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid var(--color-border);
  z-index: 9999;
  padding-bottom: 0;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 4rpx;
  position: relative;
  transition: all 0.2s;
}
.tab-icon {
  font-size: 44rpx;
  line-height: 1.4;
}
.tab-text {
  font-size: 20rpx;
  color: var(--color-text-light);
  margin-top: 2rpx;
}
.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}
.tab-item.active .tab-icon {
  transform: scale(1.1);
}
.tab-badge {
  position: absolute;
  top: 4rpx;
  right: 50%;
  transform: translateX(200%);
  background: #FF4D4F;
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
}
