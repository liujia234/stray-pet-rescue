.pet-card {
  position: relative;
  overflow: hidden;
  padding: 0;
}

/* 状态标签区 */
.card-status {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 10;
  display: flex;
  gap: 8rpx;
}
.card-type-tag {
  font-size: var(--font-xs);
  background: rgba(0,0,0,0.45);
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* 图片区 */
.card-image-area {
  width: 100%;
  height: 340rpx;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  overflow: hidden;
  background: var(--color-primary-bg);
}
.card-images {
  display: flex;
  height: 100%;
}
.card-image {
  flex: 1;
  height: 100%;
  object-fit: cover;
}
.card-image.single {
  flex: unset;
  width: 100%;
}
.image-more {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: var(--font-xs);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 占位图 */
.card-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 8rpx;
}
.placeholder-text {
  font-size: var(--font-sm);
  color: var(--color-text-light);
}

/* 信息区 */
.card-info {
  padding: var(--spacing-md);
}
.card-name {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-text);
}
.card-gender {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}
.card-desc {
  margin-top: var(--spacing-sm);
  line-height: 1.6;
}
.card-address {
  flex: 1;
  overflow: hidden;
}
.address-icon {
  font-size: var(--font-sm);
  margin-right: 4rpx;
  flex-shrink: 0;
}
.address-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作区 */
.card-actions {
  padding: 0 var(--spacing-md) var(--spacing-md);
}
