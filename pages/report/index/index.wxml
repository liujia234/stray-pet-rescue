<!-- 寻宠/拾宠列表页 -->
<navbar title="寻宠 & 拾宠" />

<view class="page-container">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <view class="tab-switch flex-row">
      <view class="tab-option {{currentTab === 'lost' ? 'active' : ''}}" bindtap="switchTab" data-tab="lost">
        寻宠启事
      </view>
      <view class="tab-option {{currentTab === 'found' ? 'active' : ''}}" bindtap="switchTab" data-tab="found">
        拾宠招领
      </view>
    </view>
    <view class="btn-add" bindtap="goAddReport">
      <text class="add-icon">+</text>
      <text class="add-text">发布</text>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{list.length > 0}}">
    <pet-card
      wx:for="{{list}}"
      wx:key="id"
      petData="{{item}}"
      cardType="{{currentTab}}"
      showType="{{true}}"
    />
  </view>
  <view wx:else class="empty-state">
    <text class="empty-icon">{{currentTab === 'lost' ? '🔍' : '🐾'}}</text>
    <text class="empty-text">{{currentTab === 'lost' ? '暂无寻宠启事，快去发布吧~' : '暂无拾宠信息，做第一个热心人吧~'}}</text>
  </view>

  <view style="height: 120rpx;"></view>
</view>
