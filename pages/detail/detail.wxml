<!-- 宠物详情页（通用：寻宠/拾宠/领养） -->
<navbar title="宠物详情" showBack="{{true}}" />

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}">
  <!-- 图片轮播 -->
  <view class="image-swiper" wx:if="{{pet.images && pet.images.length > 0}}">
    <swiper indicator-dots="{{pet.images.length > 1}}" indicator-color="#fff" indicator-active-color="#FF8C6B" autoplay circular>
      <swiper-item wx:for="{{pet.images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="swiper-image" />
      </swiper-item>
    </swiper>
  </view>
  <view wx:else class="image-placeholder" style="background: {{placeholderColor}};">
    <text class="placeholder-icon">{{pet.petType === 'cat' ? '🐱' : '🐶'}}</text>
    <text class="placeholder-text">暂无照片</text>
  </view>

  <!-- 基本信息 -->
  <view class="info-section card">
    <view class="flex-between mb-sm">
      <view class="flex-row">
        <text class="pet-name">{{pet.name || '未命名'}}</text>
        <text class="tag {{statusConfig.class}} ml-sm">{{statusConfig.text}}</text>
      </view>
      <text class="text-lg">{{pet.petType === 'cat' ? '🐱' : '🐶'}}</text>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">品种</text>
        <text class="info-value">{{pet.breed || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">毛色</text>
        <text class="info-value">{{pet.color || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{pet.age || '未知'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{genderName}}</text>
      </view>
      <view class="info-item" wx:if="{{pet.size}}">
        <text class="info-label">体型</text>
        <text class="info-value">{{sizeName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">类型</text>
        <text class="info-value">{{typeName}}</text>
      </view>
    </view>

    <view wx:if="{{pet.injury}}" class="injury-badge mt-sm">
      <text>🏥 受伤情况：{{pet.injury}}</text>
    </view>

    <view wx:if="{{pet.health}}" class="health-info mt-sm">
      <text class="text-sm">💊 健康状态：{{pet.health}}</text>
    </view>

    <view wx:if="{{pet.character}}" class="character-info mt-sm">
      <text class="text-sm">💬 性格特征：{{pet.character}}</text>
    </view>
  </view>

  <!-- 详细描述 -->
  <view class="desc-section card">
    <text class="section-label">📝 详细描述</text>
    <text class="desc-text">{{pet.description || '暂无详细描述'}}</text>
  </view>

  <!-- 地点信息 -->
  <view class="location-section card">
    <text class="section-label">📍 地点信息</text>
    <text class="location-text">{{pet.address || '未知地点'}}</text>
    <text class="text-light text-sm mt-sm">发布时间：{{createTimeText}}</text>
  </view>

  <!-- 联系方式 -->
  <view class="contact-section card" wx:if="{{pet.contact}}">
    <text class="section-label">📞 联系方式</text>
    <text class="contact-phone">{{maskedPhone}}</text>
    <view class="contact-tip text-sm text-light mt-sm">
      <text wx:if="{{pet.type === 'lost'}}">如果您有关于此宠物的线索，请立即联系宠主</text>
      <text wx:if="{{pet.type === 'found'}}">如果您是此宠物的主人，请联系好心人</text>
      <text wx:if="{{pet.type === 'adopt'}}">如果您有意领养，请联系下方救助站</text>
    </view>
  </view>

  <!-- 救助站信息（领养专用） -->
  <view class="shelter-section card" wx:if="{{pet.type === 'adopt' && pet.shelterName}}">
    <text class="section-label">🏥 救助机构</text>
    <text class="text-md text-bold">{{pet.shelterName}}</text>
    <text class="text-sm text-secondary mt-sm" style="display:block;">联系电话：{{pet.contact || '暂无'}}</text>
  </view>

  <!-- 留言区 -->
  <view class="message-section card">
    <text class="section-label">💬 留言咨询</text>
    <view wx:if="{{messages.length > 0}}" class="message-list">
      <view wx:for="{{messages}}" wx:key="id" class="message-item">
        <text class="message-user">{{item.userType === 'shelter' ? '救助站' : '用户'}}：</text>
        <text class="message-content">{{item.content}}</text>
        <text class="message-time text-light text-sm">{{item.timeText}}</text>
      </view>
    </view>
    <view wx:else class="text-light text-sm" style="padding: 16rpx 0;">暂无留言，成为第一个留言的人吧~</view>
    <view class="message-input-row flex-row mt-sm">
      <input class="form-input flex-1" placeholder="输入留言..." value="{{msgInput}}" bindinput="onMsgInput" confirm-type="send" bindconfirm="sendMessage" />
      <view class="btn-send" bindtap="sendMessage">发送</view>
    </view>
  </view>

  <!-- 操作按钮区 -->
  <view class="action-section">
    <button wx:if="{{pet.type !== 'adopt'}}" class="btn-primary" bindtap="goVideoGen">
      🎬 生成短视频素材
    </button>
    <button wx:if="{{pet.type === 'adopt'}}" class="btn-primary" bindtap="goVideoGen">
      🎬 生成领养科普视频素材
    </button>
    <view class="flex-row mt-md" style="gap: 16rpx;">
      <button class="btn-outline flex-1" bindtap="toggleFavorite">
        {{isFavorited ? '❤️ 已收藏' : '🤍 加入收藏'}}
      </button>
      <button class="btn-outline flex-1" bindtap="sharePet">
        📤 分享信息
      </button>
    </view>
  </view>

  <view style="height: 120rpx;"></view>
</scroll-view>
