<!-- 领养列表页 -->
<navbar title="领养中心" />

<view class="page-container">
  <!-- 搜索和筛选 -->
  <view class="search-bar flex-row">
    <view class="search-input-wrap flex-1">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索品种、毛色..." value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>
    <view class="filter-btn {{filterType !== 'all' ? 'active' : ''}}" bindtap="toggleFilter">
      <text>筛选</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel card" wx:if="{{showFilter}}">
    <view class="filter-row">
      <text class="filter-label">类型</text>
      <view class="filter-options">
        <text class="filter-tag {{filterType === 'all' ? 'active' : ''}}" bindtap="setFilter" data-key="filterType" data-value="all">全部</text>
        <text class="filter-tag {{filterType === 'dog' ? 'active' : ''}}" bindtap="setFilter" data-key="filterType" data-value="dog">🐶 狗狗</text>
        <text class="filter-tag {{filterType === 'cat' ? 'active' : ''}}" bindtap="setFilter" data-key="filterType" data-value="cat">🐱 猫咪</text>
      </view>
    </view>
    <view class="filter-row">
      <text class="filter-label">体型</text>
      <view class="filter-options">
        <text class="filter-tag {{filterSize === 'all' ? 'active' : ''}}" bindtap="setFilter" data-key="filterSize" data-value="all">全部</text>
        <text class="filter-tag {{filterSize === 'small' ? 'active' : ''}}" bindtap="setFilter" data-key="filterSize" data-value="small">小型</text>
        <text class="filter-tag {{filterSize === 'medium' ? 'active' : ''}}" bindtap="setFilter" data-key="filterSize" data-value="medium">中型</text>
        <text class="filter-tag {{filterSize === 'large' ? 'active' : ''}}" bindtap="setFilter" data-key="filterSize" data-value="large">大型</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar flex-between mt-md mb-md">
    <text class="text-secondary text-sm">共 {{filteredList.length}} 只待领养萌宠</text>
    <view class="flex-row">
      <view class="btn-sm btn-outline mr-sm" bindtap="showMyFavorites">
        <text>❤️ 收藏 ({{favoriteCount}})</text>
      </view>
      <view class="btn-sm btn-primary" bindtap="goApply">
        <text>📝 申请领养</text>
      </view>
    </view>
  </view>

  <!-- 列表 -->
  <pet-card
    wx:for="{{filteredList}}"
    wx:key="id"
    petData="{{item}}"
    cardType="adopt"
    showType="{{true}}"
    showActions="{{true}}"
  >
    <view slot="actions" class="card-actions-row flex-between">
      <view class="action-btn flex-row" catchtap="toggleFav" data-id="{{item.id}}">
        <text>{{isFav(item.id) ? '❤️ 已收藏' : '🤍 收藏'}}</text>
      </view>
      <view class="action-btn flex-row" catchtap="goDetail" data-id="{{item.id}}">
        <text>查看详情 ›</text>
      </view>
    </view>
  </pet-card>

  <view wx:if="{{filteredList.length === 0}}" class="empty-state">
    <text class="empty-icon">🐾</text>
    <text class="empty-text">暂无符合条件的待领养宠物</text>
  </view>

  <!-- API Key 设置入口 -->
  <view class="api-key-card card mt-lg" bindtap="setApiKey">
    <view class="flex-between">
      <view>
        <text class="text-md text-bold">🔑 AI 文案生成设置</text>
        <text class="text-sm text-light" style="display:block;margin-top:4rpx;">配置 DeepSeek API Key 开启智能文案</text>
      </view>
      <text class="text-primary">{{hasApiKey ? '✅ 已配置' : '⚙️ 去配置'}}</text>
    </view>
    <view class="flex-row mt-sm" style="gap: 16rpx;" wx:if="{{hasApiKey}}">
      <view class="btn-sm btn-outline flex-1 text-center" bindtap="testApiKey">🧪 测试连接</view>
      <view class="btn-sm btn-outline flex-1 text-center" style="color:#FF4D4F;border-color:#FF4D4F;" bindtap="clearApiKey">🗑️ 清除Key</view>
    </view>
  </view>

  <view style="height: 120rpx;"></view>
</view>
