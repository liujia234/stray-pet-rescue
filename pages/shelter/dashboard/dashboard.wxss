.stats-section {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.stat-card {
  width: calc(50% - 8rpx);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  text-align: center;
  box-sizing: border-box;
}
.stat-num-big {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text);
  display: block;
}
.stat-label-big {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.tab-bar-db {
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  padding: 6rpx;
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
  transition: all 0.3s;
}
.tab-btn.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}
