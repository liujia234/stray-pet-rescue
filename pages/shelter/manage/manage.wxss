.manage-header {
  padding: 0 4rpx;
}
.btn-add-pet {
  background: linear-gradient(135deg, var(--color-success), #8FD99A);
  color: #fff;
  padding: 14rpx 28rpx;
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  font-weight: 600;
}
.add-icon-sm {
  font-size: var(--font-lg);
  margin-right: 6rpx;
}

.manage-item {
  padding: 0;
  margin-bottom: var(--spacing-md);
  overflow: hidden;
}
.manage-actions {
  border-top: 1rpx solid var(--color-border);
}
.ma-btn {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
}
.ma-btn.edit { color: var(--color-primary); }
.ma-btn.offline { color: var(--color-warning); }
.ma-btn.online { color: var(--color-success); }
.ma-btn.delete { color: #FF4D4F; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
}
.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--spacing-lg);
  display: flex;
  flex-direction: column;
}
.modal-title {
  font-size: var(--font-lg);
  font-weight: 700;
  text-align: center;
  margin-bottom: var(--spacing-md);
}
.modal-body {
  flex: 1;
  max-height: 60vh;
}
.modal-footer {
  padding-top: var(--spacing-md);
  border-top: 1rpx solid var(--color-border);
  margin-top: var(--spacing-sm);
}
