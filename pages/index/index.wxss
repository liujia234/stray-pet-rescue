/* 首页样式 */
.hero-banner {
  background: linear-gradient(135deg, var(--color-primary), #FFA07A);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hero-content {
  flex: 1;
}
.hero-title {
  color: #fff;
  font-size: var(--font-xxl);
  font-weight: 700;
  line-height: 1.4;
  white-space: pre-line;
}
.hero-subtitle {
  display: block;
  color: rgba(255,255,255,0.85);
  font-size: var(--font-sm);
  margin-top: var(--spacing-sm);
}
.hero-pets {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.hero-pet-icon {
  font-size: 52rpx;
  opacity: 0.8;
}

/* 功能入口 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.feature-item {
  width: calc(50% - 8rpx);
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}
.feature-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
}
.feature-icon {
  font-size: 40rpx;
}
.feature-title {
  display: block;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
}
.feature-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: 4rpx;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  background: var(--color-card-bg);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-card);
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--color-primary);
}
.stat-label {
  font-size: var(--font-xs);
  color: var(--color-text-light);
  margin-top: 4rpx;
}
.stat-divider {
  width: 1rpx;
  background: var(--color-border);
}

/* Section */
.section {
  margin-bottom: var(--spacing-lg);
}
.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}
.section-more {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 活动卡片 */
.activity-card {
  padding: var(--spacing-md);
}
.activity-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.5;
}
.activity-content {
  margin-top: var(--spacing-sm);
  line-height: 1.6;
}
